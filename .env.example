# Copy file này thành .env rồi điền giá trị thật, không commit .env lên git.

DATABASE_URL="file:./dev.db"

# NextAuth — tạo secret bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Mã khóa để đăng nhập (thay cho email/mật khẩu), tự đặt một chuỗi khó đoán.
ACCESS_KEY=""

# Tài khoản seed (chỉ cần 1 tài khoản ADMIN — đăng nhập thực tế dùng ACCESS_KEY ở trên,
# tài khoản này chỉ để gắn chủ sở hữu dữ liệu). Chạy `npx prisma db seed` sau khi điền.
SEED_USERS=[{"email":"admin@example.com","name":"Admin","password":"change-me","role":"ADMIN"}]
