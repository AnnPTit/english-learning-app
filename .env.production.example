# Copy file này thành .env.production NGAY TRÊN SERVER (không commit lên git), rồi điền giá trị thật.

# Đường dẫn tới file SQLite bên trong container, khớp với volume "./data:/app/data" trong docker-compose.yml.
DATABASE_URL="file:/app/data/prod.db"

# NextAuth — PHẢI đổi secret khác với bản dev, tạo bằng:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
# Domain thật sau khi deploy qua Cloudflare Tunnel (xem PLAN.md Phase 0).
NEXTAUTH_URL="https://app.web-rtc.cloud"

# Tài khoản gia đình, chạy "docker compose exec app npx prisma db seed" sau khi container đã lên.
SEED_USERS=[{"email":"admin@example.com","name":"Admin","password":"change-me","role":"ADMIN"}]
