# Copy file này thành .env.production NGAY TRÊN SERVER (không commit lên git), rồi điền giá trị thật.

# Đường dẫn tới file SQLite bên trong container, khớp với volume "./data:/app/data" trong docker-compose.yml.
DATABASE_URL="file:/app/data/prod.db"

# Không có đăng nhập — tài khoản dưới đây chỉ để gắn chủ sở hữu dữ liệu
# (Deck/Todo), không dùng để xác thực.
# LƯU Ý: app đang public ra internet qua Cloudflare Tunnel, không có lớp bảo vệ
# nào khác — chấp nhận rủi ro ai biết domain cũng xem/sửa được dữ liệu.
# Chạy "docker compose exec app npx prisma db seed" sau khi container đã lên.
SEED_USERS=[{"email":"admin@example.com","name":"Admin","password":"change-me","role":"ADMIN"}]
